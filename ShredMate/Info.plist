	<string>ShredMate uses the camera to scan payment cards when booking a session with a mentor.</string>
	<key>STRIPE_APPLE_MERCHANT_COUNTRY</key>
	<string>$(STRIPE_APPLE_MERCHANT_COUNTRY)</string>
	<key>STRIPE_APPLE_MERCHANT_ID</key>
	<string>$(STRIPE_APPLE_MERCHANT_ID)</string>
	<key>STRIPE_PUBLISHABLE_KEY</key>
	<string>$(STRIPE_PUBLISHABLE_KEY)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UIStatusBarStyle</key>
	<string></string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>

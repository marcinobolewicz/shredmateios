"legal.terms_section_3_heading" = "3. Acceptable Use";
"legal.terms_section_3_body" = "You agree not to use ShredMate for any unlawful purpose, to harass other users, to post offensive or misleading content, or to interfere with the proper operation of the service. We reserve the right to suspend or terminate accounts that violate these rules.";

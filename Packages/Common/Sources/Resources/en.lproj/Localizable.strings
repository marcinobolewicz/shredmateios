/* Legal — Privacy Policy */
"legal.privacy_title" = "Privacy Policy";
"legal.privacy_section_1_heading" = "1. Information We Collect";
"legal.privacy_section_1_body" = "We collect information you provide directly: name, email address, profile details, location data, and sport preferences. We also collect usage data such as device information, app interactions, and crash reports to improve the service.";
"legal.privacy_section_2_heading" = "2. How We Use Your Data";
"legal.privacy_section_2_body" = "Your data is used to provide and personalize the service, match riders with mentors, display relevant spots, send notifications, and improve app performance. We do not sell your personal data to third parties.";
"legal.privacy_section_3_heading" = "3. Data Sharing";
"legal.privacy_section_3_body" = "Your public profile information (display name, avatar, sport preferences) is visible to other users. We may share anonymized analytics data with service providers. We use Firebase for crash reporting and push notifications.";
"legal.privacy_section_4_heading" = "4. Data Retention & Deletion";
"legal.privacy_section_4_body" = "Your data is retained as long as your account is active. You can request account deletion at any time through the app settings — all personal data will be permanently removed within 30 days of the request.";
"legal.privacy_section_5_heading" = "5. Your Rights";
"legal.privacy_section_5_body" = "You have the right to access, correct, or delete your personal data. To exercise these rights or for any privacy-related questions, contact us at privacy@shredmate.eu.";
